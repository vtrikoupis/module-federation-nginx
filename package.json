{
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces",
    "start": "concurrently --kill-others-on-fail \"npm run dev -w core\" \"npm run dev -w another_micro_app\" \"npm run dev -w shared\"",
    "install:parallel": "npm install"
  },
  "author": "its@vangel.is",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
